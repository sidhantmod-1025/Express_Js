<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User list</title>
</head>
<body>
  <h1>User List Page</h1>
  <ul>
    <% for(let i =0; i<user.length;i++) {%>
